{
  "manifest_version": 3,
  "name": "Taiwan-LLM-Sanitizer｜通用臺灣繁中化",
  "short_name": "TLS 繁中化",
  "version": "0.2.0",
  "description": "R2：可逐站啟用的通用臺灣繁中化；離線詞彙或可選 Chrome 本機 AI 翻譯，無雲端資料上傳。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TLS｜本站繁中在地化"
  }
}
