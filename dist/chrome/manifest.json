{
  "manifest_version": 3,
  "name": "Taiwan-LLM-Sanitizer｜臺灣繁中通用在地化",
  "short_name": "TLS 繁中化",
  "version": "0.3.0",
  "description": "通用本機翻譯＋可選臺灣語境詞庫。預設不蒐集頁面內容，逐站授權。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TLS｜本站繁中在地化"
  }
}
