{
  "manifest_version": 3,
  "name": "Taiwan-LLM-Sanitizer｜自然臺灣繁中翻譯",
  "short_name": "TLS 繁中化",
  "version": "0.4.0",
  "description": "逐站啟用的臺灣用語及 Chrome 本機 AI 翻譯，保護 Codex／Claude 等專有名稱；不自行上傳網頁內容。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TLS｜本站繁中在地化"
  }
}
