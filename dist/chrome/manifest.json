{
  "manifest_version": 3,
  "name": "Taiwan-LLM-Sanitizer｜臺灣繁中網頁在地化",
  "short_name": "TLS 繁中化",
  "version": "0.1.0",
  "description": "使用者自行選擇網站，離線校正常用介面文字與臺灣技術詞彙；不傳送頁面內容。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TLS｜本站繁中在地化"
  }
}
