{
  "manifest_version": 3,
  "name": "TLS PokéBonk 臺灣繁中試玩版（非官方）",
  "version": "0.1.0",
  "description": "Opt-in, display-only Taiwanese terminology demo. No game/state/network changes.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://pokebonk.com/*",
        "https://www.pokebonk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
