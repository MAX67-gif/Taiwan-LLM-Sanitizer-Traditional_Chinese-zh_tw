# Generated release packs are uploaded as GitHub Actions artifacts, not tracked.
dist/*.zip
dist/*SUMS*.txt

# Existing tracked files are not removed by .gitignore.
# tools/publication_guard.py enforces a stricter fail-closed public allowlist.

# R5 generated release Userscript alias (attached to GitHub Release)
dist/TLS_Tampermonkey_R*_*.user.js

# R6 local benchmark results, outputs, reviewer notes and future unseen items
r6_results/
R6_LOCAL_RESULTS/
benchmarks/r6/private/
benchmarks/r6/results/
benchmarks/r6/unseen/
*_R6_PRIVATE_*
*LOCAL_HUMAN_REVIEWS*
*_model_output.jsonl
*_review_template.jsonl
*_structural_report.json

# Generated public-cohort structural baseline; never commit generated result
benchmarks/r6/R6_STRUCTURAL_BASELINE.json

# R6 reproducible study kit checksum
dist/*.sha256


# R11 release bundles are built by CI, while source and unpacked artifacts are tracked.
dist/r11/*.zip
dist/r11/*SUMS*.txt
dist/r11/TLS_Tampermonkey_R11_*.user.js

# R13 immutable Release bundles generated by CI, not committed as binary assets.
dist/r13/*.zip
dist/r13/*SUMS*.txt
dist/r13/TLS_Tampermonkey_R13_*.user.js

# R17.7 has one source tree; the exact-member installer and unpacked test copy
# are rebuilt and SHA-verified by CI, not duplicated as tracked source.
dist/r177/

